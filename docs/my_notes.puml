@startuml
skinparam monochrome true
skinparam linetype polyline

start
:Select Model Configuration;
if (Model Type) then (GraphLAM)
  :Initialize GraphLAM;
elseif (HiLAM) then
  :Initialize HiLAM;
elseif (HiLAM Parallel) then
  :Initialize HiLAM Parallel;
endif

:Load Configuration;
:Set Random Seed;
:Prepare Data Module;

fork
  :Configure Training Parameters;
  :Set Epochs;
  :Set Learning Rate;
  :Set Batch Size;
fork again
  :Setup Validation Strategy;
  :Define Validation Interval;
  :Configure Metrics Tracking;
end fork

:Initialize PyTorch Lightning Trainer;
:Start Model Training;

if (Evaluation Mode) then (yes)
  :Load Checkpoint;
  :Run Model Assessment;
  :Generate Performance Reports;
else (no)
  :Continue Training;
endif

:Save Best Model;
stop
@enduml



@startuml
skinparam monochrome true
skinparam linetype polyline

start
:Initialize GraphLAM Model;
note right: Extends BaseGraphModel

fork
  :Validate Graph Configuration;
  if (Hierarchical?) then (yes)
    #red:Raise Assertion Error;
    end
  else (no)
    :Proceed with Non-Hierarchical Graph;
  endif
fork again
  :Extract Feature Dimensions;
  note right: Mesh and Edge Feature Sizes
endfork

:Create Mesh Embedders;
note right: Multi-Layer Perceptron (MLP)
- Mesh Static Features
- Mesh-to-Mesh Edge Features

:Initialize Interaction Networks;
note right: Multiple Processor Layers
- Dynamic Interaction Layers
- Configurable Aggregation

fork
  :Embed Mesh Nodes;
  note right: Transform static features
fork again
  :Prepare Edge Representations;
  note right: Process mesh-to-mesh connections
endfork

:Process Mesh Representation;
note right: Core Graph Neural Network Step
- Batch-level Updates
- Dynamic Feature Integration

:Generate Final Representation;
note right: Prepared for Downstream Tasks
- Weather Prediction
- Atmospheric Modeling

stop
@enduml


