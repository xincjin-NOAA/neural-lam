start
:Parse Arguments;
if (Select Model) then (graph_lam)
  :Initialize GraphLAM;
elseif (hi_lam) then
  :Initialize HiLAM;
elseif (hi_lam_parallel) then
  :Initialize HiLAMParallel;
endif

:Load Config and Datastore;
:Set Random Seed;
:Prepare Weather Data Module;
:Train/Evaluate Model;
