
@startuml
title Mesh Graph Creation Process

start
:Parse Command Line Arguments;
:Load Configuration;
:Load Grid Positions;

if (Hierarchical Graph?) then (yes)
  :Create Multi-Resolution Mesh Graphs with Levels;
  :Relabel Nodes with Level Index;
  :Create Inter-Level Mesh Edges;
else (no)
  :Create Multi-Resolution Mesh Graphs;
endif

if (Plot Enabled?) then (yes)
  :Plot Graphs;
endif

:Grid-to-Mesh Graph Conversion;
:Mesh-to-Grid Graph Conversion;
:Save Graph Edges;
stop
@enduml

@startuml
title Grid Features Preprocessing

start
:Parse Command Line Arguments;
:Load Data Configuration;
:Determine Static Directory Path;

fork
  :Load Grid Coordinates (nwp_xy.npy);
  :Normalize Coordinates;
fork again
  :Load Geopotential Data (surface_geopotential.npy);
  :Rescale to [0, 1] Range;
fork again
  :Load Border Mask (border_mask.npy);
  :Convert to Float;
end fork

:Concatenate Grid Features;
:Save Features as grid_features.pt;

stop
@enduml

@startuml
title Neural LAM: Graph-Based Weather Prediction Model

skinparam monochrome true
skinparam linetype polyline

actor "Input Data" as InputData
participant "Graph Loading" as GraphLoading
participant "Static Feature Extraction" as StaticFeature
participant "Node Dimension Specification" as NodeDimension
participant "Grid and Mesh Node Embedding" as NodeEmbedding
participant "Grid-to-Mesh Embedder" as G2MEmbedder
participant "Mesh-to-Grid Embedder" as M2GEmbedder
participant "Graph Neural Network Encoder" as GNNEncoder
participant "Processor Step" as ProcessorStep
participant "Graph Neural Network Decoder" as GNNDecoder
participant "Output Transformation" as OutputTransform
participant "Prediction/Forecast" as Prediction

InputData -> GraphLoading: Load Graph
GraphLoading -> StaticFeature: Register Buffers
StaticFeature -> NodeDimension: Calculate Dimensions
NodeDimension -> NodeEmbedding: Embed Nodes
NodeEmbedding -> G2MEmbedder: Transform Features
G2MEmbedder -> GNNEncoder: Encode
GNNEncoder -> ProcessorStep: Process
ProcessorStep -> M2GEmbedder: Transform Features
M2GEmbedder -> GNNDecoder: Decode
GNNDecoder -> OutputTransform: Map Output
OutputTransform -> Prediction: Generate Forecast

note right of GraphLoading
  Hierarchical Graph Processing
  Dynamic Feature Extraction
end note

note right of GNNEncoder
  Bidirectional Feature Learning
  Complex Spatial Dependencies
end note

@enduml

